// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  googleId     String?   @unique
  sessions       Session[]
  conversations  Conversation[]
  journalEntries JournalEntry[]
  seeds          UserSeeds?
  seedTransactions SeedTransaction[]
  achievements   Achievement[]
  assessments    Assessment[]
  referralCode   ReferralCode?
  referredBy     Int?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model UserSeeds {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  total          Int      @default(0)
  lifetimeEarned Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model SeedTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  meta      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model Achievement {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug     String
  earnedAt DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId])
}

model Assessment {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  score     Int
  band      String
  answers   Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, type])
}

model ReferralCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  uses      Int      @default(0)
  createdAt DateTime @default(now())
}

model WaitlistEntry {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String
  city      String?
  concern   String?
  createdAt DateTime @default(now())

  @@index([email])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Therapist {
  id           Int         @id @default(autoincrement())
  name         String
  title        String
  experience   Int
  gender       String
  email        String?     @unique
  passwordHash String?
  sessionToken String?     @unique
  conversations Conversation[]
  sessionTypes SessionType[] @relation("TherapistSessionTypes")
  specialities Concerns[] @relation("TherapistConcerns")
  therapyTypes TherapyType[] @relation("TherapistTherapyTypes")
  languages    Language[]   @relation("TherapistLanguages")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}


model Concerns {
  id         String      @id @default(uuid())
  name       String      @unique
  therapists Therapist[] @relation("TherapistConcerns")
  createdAt  DateTime    @default(now())
}

model Admin {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  password     String
  name         String
  role         String    @default("admin")
  sessionToken String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Conversation {
  id           Int         @id @default(autoincrement())
  userId       Int
  therapistId  Int
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  therapist    Therapist    @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  messages     Message[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([userId, therapistId])
  @@index([userId])
  @@index([therapistId])
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String
  conversationId Int
  senderType     String
  senderId       Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model JournalEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  content   String
  mood      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model SessionType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  therapists  Therapist[] @relation("TherapistSessionTypes")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TherapyType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  therapists  Therapist[] @relation("TherapistTherapyTypes")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Language {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  therapists  Therapist[] @relation("TherapistLanguages")

  createdAt   DateTime  @default(now())
}